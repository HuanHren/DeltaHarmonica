<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <application android:name=".IsolatedTestApplication" tools:replace="android:name">
        <provider android:name=".update.UpdateFileProvider" tools:node="remove" />
        <service android:name=".accessibility.TouchAccessibilityService" tools:node="remove" />
        <service android:name=".overlay.CalibrationOverlayService" tools:node="remove" />
        <!-- Keep the icon preference testable without publishing a launcher entry. -->
        <activity-alias
            android:name=".WaveLauncher"
            android:targetActivity=".MainActivity"
            android:exported="false"
            tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </activity-alias>
        <activity-alias
            android:name=".CompassLauncher"
            android:targetActivity=".MainActivity"
            android:exported="false"
            tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </activity-alias>
        <provider android:name="com.huanhren.deltaharmonica.ImportTestProvider"
            android:authorities="${applicationId}.importprovider"
            android:exported="false" />
    </application>
</manifest>
