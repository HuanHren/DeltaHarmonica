<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- As in Miuix's Android sample, the blur API is only used on Android 13+. -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <queries>
        <package android:name="com.tencent.tmgp.dfm" />
    </queries>
    <application
        android:name=".DeltaHarmonicaApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/studio_locales"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.DeltaHarmonica">
        <service
            android:name=".accessibility.TouchAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service" />
        </service>
        <service android:name=".overlay.CalibrationOverlayService" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true" />
        <activity-alias android:name=".WaveLauncher" android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_launcher" android:exported="true" android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".CompassLauncher" android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_launcher_compass" android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
